digraph "calc.before" {
  node [shape=box, fontname="monospace"];
  exit [shape=oval];
  B1 [label="B1\lk := 3\lm := k + 4\lbig := m < 10\lt1 := a * 1\lx := t1 + 0\lt2 := a + b\lt3 := a + b\lu := t2 * t3\ldead := x * m\lif big goto L1_then\lgoto L1_else\l"];
  B2 [label="B2\lL1_then:\lr := u + m\lgoto L1_end\l"];
  B3 [label="B3\lL1_else:\lr := a / b\l"];
  B4 [label="B4\lL1_end:\lreturn r\l"];
  B1 -> B2 [label="true"];
  B1 -> B3 [label="false"];
  B2 -> B4;
  B3 -> B4;
  B4 -> exit;
}
