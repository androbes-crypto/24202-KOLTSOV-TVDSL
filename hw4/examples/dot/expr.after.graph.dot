graph "expr.after" {
  node [shape=circle, style=filled];
  t1 [label="t1\nr0", fillcolor="#8dd3c7"];
  t2 [label="t2\nr0", fillcolor="#8dd3c7"];
  t4 [label="t4\nr0", fillcolor="#8dd3c7"];
  t5 [label="t5\nr0", fillcolor="#8dd3c7"];
  t6 [label="t6\nr1", fillcolor="#ffffb3"];
  t7 [label="t7\nr1", fillcolor="#ffffb3"];
  t8 [label="t8\nr2", fillcolor="#bebada"];
  t2 -- t6;
  t2 -- t7;
  t2 -- t8;
  t7 -- t8;
}
